 README.md         |  1 +
 next.config.ts    | 14 ++++++++++++++
 src/data/works.ts |  3 +--
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/README.md b/README.md
index c42ac40..3c31f57 100644
--- a/README.md
+++ b/README.md
@@ -15,6 +15,7 @@ npm run dev
 
 - `/` — 凍乾目錄首頁（編號清單、關於匠寵）
 - `/challenge` — 嗷嗚計劃：青蛙誰在怕
+- `/haodada` — 反向代理到 GitHub Pages 上的嚎大大雞霸形象站
 
 ## 技術
 
diff --git a/next.config.ts b/next.config.ts
index 0349f73..075200a 100644
--- a/next.config.ts
+++ b/next.config.ts
@@ -1,7 +1,21 @@
 import type { NextConfig } from "next";
 
+const HAODADA_ORIGIN = "https://aa89976566.github.io/haodada";
+
 const nextConfig: NextConfig = {
   allowedDevOrigins: ["127.0.0.1", "localhost"],
+  async rewrites() {
+    return [
+      {
+        source: "/haodada",
+        destination: `${HAODADA_ORIGIN}/`,
+      },
+      {
+        source: "/haodada/:path*",
+        destination: `${HAODADA_ORIGIN}/:path*`,
+      },
+    ];
+  },
 };
 
 export default nextConfig;
diff --git a/src/data/works.ts b/src/data/works.ts
